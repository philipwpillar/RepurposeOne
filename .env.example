# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL (canonical for OG/sitemap/robots; Capacitor remote URL is separate)
NEXT_PUBLIC_SITE_URL=https://voiceora.io

# Google OAuth (optional — email/password works without this)
# Set to "true" after enabling Google provider in Supabase dashboard
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# AI (OpenRouter — text/vision; swap models without code changes)
OPENROUTER_API_KEY=sk-or-v1-...
AI_PROVIDER=openrouter
# Model tiers — see FORMAT_MODEL_TIER in lib/config.ts for per-format routing
# fast:   cheap + quick (simple/short formats)
# strong: higher quality (threads, newsletters, multi-part output)
AI_MODEL_FAST=qwen/qwen3.5-35b-a3b
AI_MODEL_STRONG=qwen/qwen3.5-397b-a17b
AI_MODEL_VISION=qwen/qwen3.5-397b-a17b
AI_TEMPERATURE=0.7
# Leave unset to use the default (INPUT_CONTENT_MAX_LENGTH, currently 20000)
# AI_MAX_INPUT_CHARS=20000
# Leave unset to use the default (2,000,000)
# AI_MAX_IMAGE_BASE64_CHARS=2000000

# Plan limits (monthly successful repurposes per tier)
PLAN_LIMIT_FREE=10
PLAN_LIMIT_CREATOR=100
PLAN_LIMIT_PRO=1000
PLAN_LIMIT_PRO_PLUS=1000

# Burst rate limit for /api/generate (per user, rolling window)
RATE_LIMIT_MAX_REQUESTS=10
# Higher burst ceiling for Pro Plus (N3)
RATE_LIMIT_MAX_REQUESTS_PRO_PLUS=20
RATE_LIMIT_WINDOW_MINUTES=10

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_CREATOR=price_...
STRIPE_PRICE_ID_PRO=price_...
# Pro Plus — one Price object with GBP settlement + USD/EUR manual points
STRIPE_PRICE_ID_PRO_PLUS=price_...

# Supabase service role — server-only, NEVER expose to the client.
# Required because the Stripe webhook has no user session and must be able
# to update any user's profile row by stripe_customer_id.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Dev harness + video bundle UI flag — keep unset in production until GDPR/D6 close-out
# NEXT_PUBLIC_VIDEO_BUNDLES_DEV=true
# Max video upload size (MB) — must match Supabase Storage plan; client + server read this
# NEXT_PUBLIC_VIDEO_MAX_MB=45

# Holding-page gate — Production only (never Preview/QA). Unset HOLDING_MODE to go live.
# Generate token: openssl rand -hex 16
# Bypass: visit /?preview=<token> once; middleware sets httpOnly cookie for 30 days.
# HOLDING_MODE=true
# HOLDING_BYPASS_TOKEN=

# Sentry (optional — SDK no-ops when DSN unset; set on Vercel for production)
# NEXT_PUBLIC_SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# Source-map upload (CI/Vercel only — leave unset locally)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
